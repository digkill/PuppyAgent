# Loaded automatically from Puppy Agent's root .env on CLI startup.
# Existing shell environment values take priority. Keep real keys out of version control.
ARGO_LINK_API_KEY=
# ARGOLINK_API_KEY is also accepted.
KIE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PUPPY_TMP_DIR=/Volumes/Data/CodexTemp/puppy-agent
# Main engines: claude-opus-5-5 or claude-fable-5
PUPPY_MODEL=claude-opus-5-5
PUPPY_EFFORT=medium
PUPPY_PROVIDER=argolink
PUPPY_MEMORY=true
PUPPY_FUNCTION_CALLING=true
PUPPY_MAX_TOKENS=16384
PUPPY_COMPACTION_MAX_TOKENS=16384
PUPPY_CONTEXT_TOKENS=128000
# -1: continue within task budget; 0: off; 1..8: consecutive continuation cap.
PUPPY_MAX_CONTINUATIONS=-1
PUPPY_STREAM=true
# Local inference example: provider=ollama, model=an installed model ID, effort=auto.
# PUPPY_BASE_URL=http://127.0.0.1:11434/v1
# Optional: explicit dotenv path for an installed CLI.
# PUPPY_ENV_FILE=/path/to/.env
# Optional: absolute path to your persistent config.
# PUPPY_CONFIG=/path/to/config.json

PUPPY_FALLBACK_MODEL=claude-sonnet-5-5

# Default permissions, including restored sessions. Available modes:
# read-only: read project/temp; deny writes, shell commands and memory updates.
# ask: read project/temp; ask before writes, shell, memory and outside access.
# workspace-write: read/write project/temp; ask for shell, memory and outside access.
# full-access: files, shell and memory without approval under your OS account.
# Priority: --permission > PUPPY_PERMISSION_MODE > saved session > config.
PUPPY_PERMISSION_MODE=ask
# Review the original goal before completion; remaining work continues automatically.
PUPPY_GOAL_CHECK=true
PUPPY_MAX_STEPS=80

# Total API requests per task, shared by parent, helpers, summaries and goal checks.
# Positive integer. Raising the limit retains all requests already used.
PUPPY_MAX_PACK_CALLS=80
# Total API request deadline in ms (900000 = 15 minutes).
PUPPY_REQUEST_TIMEOUT_MS=900000
# Stream idle limit in ms, reset by incoming chunks (180000 = 3 minutes).
PUPPY_STREAM_IDLE_TIMEOUT_MS=180000
